# ===== free-claude-code "mix": opus=assinatura Anthropic real, sub-agentes=DeepSeek oficial =====
DEEPSEEK_API_KEY=<REDACTED-set-your-own>

# opus -> Claude real (assinatura Max via OAuth do ~/.claude/.credentials.json)
MODEL=anthropic/claude-opus-4-8
MODEL_OPUS=anthropic/claude-opus-4-8
# sonnet -> DeepSeek V4 Pro (oficial)   | haiku -> DeepSeek V4 Flash (oficial)
MODEL_SONNET=deepseek/deepseek-v4-pro
MODEL_HAIKU=deepseek/deepseek-v4-flash

ENABLE_OPUS_THINKING=true
ENABLE_SONNET_THINKING=true
ENABLE_HAIKU_THINKING=false
ENABLE_MODEL_THINKING=false

PORT=8086
HTTP_READ_TIMEOUT=120
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=10
LOG_API_ERROR_TRACEBACKS=true

# ===== Concorrência (per-provider GlobalRateLimiter) =====
# O default do free-claude-code (max_concurrency=5, 40 req/60s) é um GARGALO para os
# tiers DeepSeek: workflows com sub-agents paralelos saturam os 5 slots e cada chamada
# de haiku/sonnet fica 15-27s na fila por um slot (HTTP 200 na hora, 1º evento SSE ~27s
# depois). A conta DeepSeek permite 500 (v4-pro) / 2500 (v4-flash) conexões simultâneas.
# Limiter é por-provider, então opus (assinatura) tem o seu próprio — 500 é só teto.
PROVIDER_MAX_CONCURRENCY=500
# A janela req/min é artificial (DeepSeek limita por concorrência, não por req/min).
PROVIDER_RATE_LIMIT=10000
PROVIDER_RATE_WINDOW=60
